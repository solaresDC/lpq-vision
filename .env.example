ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_TOKEN   # used by the real bot from Fase 2
POSTGRES_USER=lpq
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=lpq
DATABASE_URL=postgresql://lpq:REPLACE_WITH_DB_PASSWORD@postgres:5432/lpq
# BIND_IP: the IP the API binds to. OMIT on the laptop (defaults to 127.0.0.1).
# On the SERVER set it to the Tailscale IP so Docker never exposes the public side:
# BIND_IP=100.126.179.123
# --- Fase-2 TEMPORAL scaffolding: these three keys die in FASE 3 (.env never touches git) ---
TELEGRAM_CHAT_ID=REPLACE_WITH_GROUP_CHAT_ID   # the demo group's numeric id (the bot's /id prints it); FASE 3 moves it to sites.telegram_chat_id
# Account hashes: pbkdf2_sha256$<iterations>$<salt>$<hash>, made by the listed command
#   docker compose -f compose.mac.yaml exec fastapi python -m api.auth make-hash admin
# and pasted EXACTLY as printed (single-quoted: the format carries $ and Compose must not interpolate it).
ADMIN_PASSWORD_HASH='REPLACE_WITH_ADMIN_HASH'
DEMO_PASSWORD_HASH='REPLACE_WITH_DEMO_HASH'
# --- Bake-off era (FUTURE, optional): other providers' keys under LiteLLM's standard names.
# An absent key = that provider is skipped and its column printed "sin llave", never an error.
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
